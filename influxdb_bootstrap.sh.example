#!/usr/bin/env bash
set -euo pipefail

export INFLUX_HOST="${INFLUX_HOST:-http://127.0.0.1:8086}"
export INFLUX_ORG="${INFLUX_ORG:-your-org}"
export INFLUX_TOKEN="${INFLUX_TOKEN:-your-token}"
export INFLUX_BUCKET="${INFLUX_BUCKET:-rto_mock_dev}"

if ! influx config list | grep -q '[[:space:]]local-rto[[:space:]]'; then
  influx config create \
    --config-name local-rto \
    --host-url "$INFLUX_HOST" \
    --org "$INFLUX_ORG" \
    --token "$INFLUX_TOKEN" \
    --active
fi


if ! influx bucket list --name "$INFLUX_BUCKET" | grep -q "$INFLUX_BUCKET"; then
  influx bucket create --name "$INFLUX_BUCKET" --org "$INFLUX_ORG"
fi

influx write \
  --bucket "$INFLUX_BUCKET" \
  --org "$INFLUX_ORG" \
  --precision s \
  --file /Users/andy/Desktop/实习/Web/rto_seed.lp

echo "InfluxDB bucket and seed data are ready in bucket: $INFLUX_BUCKET"
